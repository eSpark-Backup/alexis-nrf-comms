#include "Application.hpp"

#include "spi.h"
#include <stdio.h>    // For printf and snprintf
#include <stdlib.h>   // For rand, srand
#include <time.h>     // For time to seed rand




void Application::HAL_GPIO_EXTI_Callback_Tx()
{
		nrf24l01p_tx_irq(); // clear interrupt flag
}

void Application::HAL_GPIO_EXTI_Callback_Rx()
{
	nrf24l01p_rx_receive(rx_data);
	if (strcmp((char*)rx_data, SERVER_MESSAGE) == 0)
	{

		node_current_status = _transmitter;
		nrf24l01p_tx_init(2500, _1Mbps); // initialize it to transmit ack data
		nrf24l01p_tx_transmit((uint8_t*)ack_msg);// Send acknowledgment message back to the server
		nrf24l01p_rx_init(2500, _1Mbps); //again initialize it to recieve ack data
		node_current_status = _Receiver;
	}
}

void Application::Rx_Tx_Callback_Handler()
{
    nrf_status_t currentStatus = getNrfStatus();

    switch (currentStatus)
    {
        case TX_DONE:
            HAL_GPIO_EXTI_Callback_Tx();
            break;

        case RX_DONE:
            HAL_GPIO_EXTI_Callback_Rx();
            break;

        default:
            break;
    }
}


nrf_status_t Application::getNrfStatus()
{
    uint8_t status = nrf24l01p_get_status();

    if (TX_DS(status) == 0x20)
    {
        return TX_DONE;
    }
    else if (RX_DS(status) == 0x40)
    {
        return RX_DONE;
    }

    return TX_DONE;
}


void Application::handleWakeUp()
{
	  printf("Yes, I am awake!\n");
}

void Application::handleSleep()
{
    // Perform actions when the system is in sleep mode
	printf("Now,Fall to Sleep!\n");
    HAL_PWR_EnterSLEEPMode(PWR_LOWPOWERREGULATOR_ON, PWR_SLEEPENTRY_WFI);
}

void Application::generateAckMessage(char *uidString, size_t size)
{
	// Get the UID values
	uid[0] = HAL_GetUIDw0();
	uid[1] = HAL_GetUIDw1();
	uid[2] = HAL_GetUIDw2();

	// Format the UID into a string
	snprintf(uidString, size, "%08X%08X%08X", uid[0], uid[1], uid[2]);
}

void Application::setup()
{
	nrf24l01p_rx_init(2500, _1Mbps); //initialize it to recieve ack data
	generateAckMessage(ack_msg, sizeof(ack_msg));
	HAL_PWR_EnableSleepOnExit();
}

void Application::loop()
{
	switch (node_current_status)
	{
		case _transmitter:
			handleWakeUp();
			break;
		case _Receiver:
			handleSleep();
			break;
	}
}
