void Operation::HAL_GPIO_EXTI_Callback_Tx()
{
		nrf24l01p_tx_irq(); // clear interrupt flag
}

void Operation::HAL_GPIO_EXTI_Callback_Rx()
{
	nrf24l01p_rx_receive(rx_data);
	if (strcmp((char*)rx_data, SERVER_MESSAGE) == 0)
	{
		nrf24l01p_tx_init(2500, _1Mbps); // initialize it to transmit ack data
		nrf24l01p_tx_transmit(ack_msg.data());// Send acknowledgment message back to the server
		nrf24l01p_rx_init(2500, _1Mbps); //again initialize it to recieve ack data
	}
}

void Operation::Rx_Tx_Callback_Handler()
{
    nrf_status_t currentStatus = getNrfStatus();

    switch (currentStatus)
    {
        case TX_DONE:
            HAL_GPIO_EXTI_Callback_Tx();
            break;

        case RX_DONE:
            HAL_GPIO_EXTI_Callback_Rx();
            break;

        default:
            break;
    }
}

nrf_status_t Operation::getNrfStatus()
{
    uint8_t status = nrf24l01p_get_status();

    if (TX_DS(status) == 0x20)
    {
        return TX_DONE;
    }
    else if (RX_DS(status) == 0x40)
    {
        return RX_DONE;
    }

    return TX_DONE;
}

void Operation::handleWakeUp()
{
	  printf("Yes, I am awake!\n");
}

void Operation::generateAckMessage()
{
	// Get the UID values
	uid[0] = HAL_GetUIDw0();
	uid[1] = HAL_GetUIDw1();
	uid[2] = HAL_GetUIDw2();
	message = "Waked up";

	size_t totalSize = sizeof(uid) + message.size() + 1; // +1 for null terminator

	ack_msg.resize(totalSize);
	memcpy(ack_msg.data(), uid, sizeof(uid));
	memcpy(ack_msg.data() + sizeof(uid), message.c_str(), message.size());
	ack_msg[sizeof(uid) + message.size()] = '\0';
}

void Operation::setup()
{
	nrf24l01p_rx_init(2500, _1Mbps); //initialize it to recieve ack data
	generateAckMessage();
	HAL_PWR_EnableSleepOnExit();
}

