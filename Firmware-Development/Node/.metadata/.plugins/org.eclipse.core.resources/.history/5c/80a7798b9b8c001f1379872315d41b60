#include "NRF_Transceiver.hpp"
#include "spi.h"


void NRF_Transceiver::setup()
{
	nrf24l01p_tx_init(2500, _1Mbps); // initialize it to transmit wake up to all active nodes
	setupNodeEnvironment();

}

void NRF_Transceiver::loop()
{
	wakeUpSleepingNodes();
	checkNodeTimeouts();
}


void NRF_Transceiver::HAL_GPIO_EXTI_Callback_Tx(uint16_t GPIO_Pin)
{
	if(GPIO_Pin == NRF24L01P_IRQ_PIN_NUMBER)
		nrf24l01p_tx_irq(); // clear interrupt flag
}

void NRF_Transceiver::HAL_GPIO_EXTI_Callback_Rx(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == NRF24L01P_IRQ_PIN_NUMBER)
    	receiveAckMessage();

}

void NRF_Transceiver::setupNodeEnvironment()
{
    // Initialize nodes
    for (int i = 0; i < MAX_NODES; i++)
    {
        nodes[i].id = INVALID_NODE_ID;  // Mark node as unused
        nodes[i].awake = false;
        nodes[i].lastAckTime = 0;
        nodes[i].retryCount = 0;
    }
}

void NRF_Transceiver::wakeUpSleepingNodes()
{
	if (getCurrentTime() - lastWakeupTime > 5000)
	{
	            sendWakeupMessage();
	            lastWakeupTime = getCurrentTime();
	 }
}

void NRF_Transceiver::sendWakeupMessage(void)
{

  nrf24l01p_tx_transmit(wakeup_msg);

}

void NRF_Transceiver::receiveAckMessage(void)
{
    uint8_t rx_data[32];
    nrf24l01p_rx_receive(rx_data);

	// If the node does not exist, assign it a new slot
	if (!isNodeExist(rx_data[0]))
	{
		addNewNode(rx_data[0]);
	}
}

void NRF_Transceiver::checkNodeTimeouts(void)
{
    uint32_t currentTime = getCurrentTime();

	for (int i = 0; i < MAX_NODES; i++)
	{
		if (nodes[i].id != INVALID_NODE_ID && nodes[i].awake)
		{
			// Check if the node has timed out
			if ((currentTime - nodes[i].lastAckTime) > NODE_TIMEOUT)
			{
				// Increment retry count if node is still alive but missed acknowledgments
				nodes[i].retryCount++;

				// If the node has exceeded the retry limit, remove it
				if (nodes[i].retryCount > MAX_RETRIES)
				{
					printf("Node with ID %d is no longer active. Removing from environment.\n", nodes[i].id);

					// Shift remaining nodes to fill the gap
					removeNode(i);
				}
			}
		}
	}
}


uint32_t NRF_Transceiver::getCurrentTime(void)
{
	return HAL_GetTick();
}

bool NRF_Transceiver::isNodeExist(uint8_t node_id)
{
	for (int i = 0; i < MAX_NODES; i++)
	{
		if (nodes[i].id == node_id)
		{
			// Node exists, update its state and ack time
			nodes[i].awake = true;
			nodes[i].lastAckTime = getCurrentTime();
			return true;
		}
	}
	return false;
}

void NRF_Transceiver::addNewNode(uint8_t node_id)
{
	for (int i = 0; i < MAX_NODES; i++)
	{
		if (nodes[i].id == INVALID_NODE_ID)  // Assuming INVALID_NODE_ID is a constant representing unused slots
		{
			nodes[i].id = node_id;
			nodes[i].awake = true;
			nodes[i].lastAckTime = getCurrentTime();
			printf("New node with ID %d added to environment.\n", node_id);
			break;
		}
	}
}

void NRF_Transceiver::retryWakeUpNode(int nodeId)
{
    if (nodes[nodeId].retryCount < MAX_RETRIES)
    {
        printf("Retrying wake-up for Node %d (Attempt %d)\n", nodeId, nodes[nodeId].retryCount + 1);
        nrf24l01p_tx_transmit(wakeup_msg);  // Send wake-up message
        nodes[nodeId].retryCount++;  // Increment retry count
    }
    else
    {
        printf("Max retries reached for Node %d. Stopping wake-up attempts.\n", nodeId);
        // You can add additional logic here if needed (e.g., mark node as unreachable)
    }
}

void NRF_Transceiver::removeNode(int index)
{
    // Shift remaining nodes to fill the gap
    for (int i = index; i < MAX_NODES - 1; i++)
    {
        nodes[i] = nodes[i + 1];  // Move node at i+1 to i
    }

    // Clear the last node slot to free up memory
    nodes[MAX_NODES - 1].id = INVALID_NODE_ID;
    nodes[MAX_NODES - 1].awake = false;
    nodes[MAX_NODES - 1].lastAckTime = 0;
    nodes[MAX_NODES - 1].retryCount = 0;

    printf("Nodes shifted after removal. Node at index %d removed.\n", index);
}
